-- Executor-specific hooks are optional. If Delta does not expose one of them,
-- continue to the UI instead of aborting the entire script before it appears.
local canHookFunction = type(hookfunction) == "function"
local canHookMeta = type(hookmetamethod) == "function"
local wrapClosure = type(newcclosure) == "function" and newcclosure or function(fn) return fn end
local oldInvokeServer
if canHookFunction and UpdateDamageKey and UpdateDamageKey:IsA("RemoteFunction") then
    pcall(function()
        oldInvokeServer = hookfunction(UpdateDamageKey.InvokeServer, wrapClosure(function(self, ...)
            local args = {...}
            damageKey = args[1]
            return oldInvokeServer(self, ...)
        end))
    end)
end

-- NewIndex hook is installed only when the executor exposes the required APIs.
local oldNewIndex
if canHookMeta and type(checkcaller) == "function" then
    pcall(function()
        oldNewIndex = hookmetamethod(game, "__newindex", wrapClosure(function(self, idx, val)
            if not checkcaller() and self:IsA("Humanoid") then
                if idx == "WalkSpeed" and Config.SpeedHackEnabled then
                    return oldNewIndex(self, idx, Config.WalkSpeedValue)
                elseif idx == "JumpPower" and Config.JumpHackEnabled then
                    return oldNewIndex(self, idx, Config.JumpPowerValue)
                elseif idx == "JumpHeight" and Config.JumpHackEnabled then
                    return oldNewIndex(self, idx, Config.JumpPowerValue / 7.84)
                end
            end
            return oldNewIndex(self, idx, val)
        end))
    end)
end

-- Namecall hook is optional and guarded for executors with partial API support.
local oldNamecall
if canHookMeta and type(getnamecallmethod) == "function" then
    pcall(function()
        oldNamecall = hookmetamethod(game, "__namecall", wrapClosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if self == SendData and (method == "FireServer" or method == "fireServer") then
        local eventName = args[1]
        if type(eventName) == "string" then
            -- Block AC detection logs
            if eventName == "AC Tamper" or eventName == "MemCheck" or eventName == "ZombieBox" or eventName == "ESP" then
                print("[BYPASS] Blocked Anti-Cheat Check:", eventName)
                return
            end
            
            -- Spoof weapon stats so the server thinks they are unmodified
            if eventName:sub(1,1) == "W" then
                local wIndex = eventName
                local default = originalStats[wIndex]
                if not default then
                    local wp = LocalPlayer.Backpack:FindFirstChild(wIndex) or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(wIndex))
                    if wp then cacheWeapon(wp) end
                    default = originalStats[wIndex]
                end
                if default and type(args[2]) == "table" then
                    args[2].WeaponName = default.WeaponName
                    args[2].Ammo = default.Ammo
                    args[2].StoredAmmo = default.StoredAmmo
                    args[2].DamageMax = default.DamageMax
                    args[2].DamageMin = default.DamageMin
                    args[2].FireTime = default.FireTime
                end
                return oldNamecall(self, unpack(args))
            end
        end
    end
    
    -- Capture damage key from normal shooting if we missed it
    if self.Name == "Damage" and (method == "FireServer" or method == "fireServer") then
        local key = args[2]
        if key and type(key) == "number" and key >= 0 and key < 1 then
            damageKey = key
        end
    end
    
            return oldNamecall(self, ...)
        end))
    end)
end

-- Function to search GC for existing damage key
local function getDamageKeyFromGC()
    if type(getgc) ~= "function" or type(debug) ~= "table" then return end
    local getinfo = debug.getinfo or getinfo
    if type(getinfo) ~= "function" then return end
    local gcOk, gcItems = pcall(getgc)
    if not gcOk or type(gcItems) ~= "table" then return end
    for _, f in ipairs(gcItems) do
        if type(f) == "function" then
            local infoOk, info = pcall(getinfo, f)
            if infoOk and info and info.source and info.source:find("WeaponScript") then
                for i = 1, 30 do
                    local ok, name, val = pcall(debug.getupvalue, f, i)
                    if ok and type(val) == "number" and val >= 0 and val < 1 then
                        damageKey = val
                        return val
                    end
                end
            end
        end
    end
end
getDamageKeyFromGC() -- Try to capture immediately

